@model IEnumerable<trafficFineManager.Entities.Vehicle>
@{
    ViewData["Title"] = "Araç Yönetimi";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Araç Yönetimi</h2>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-circle me-1"></i> Yeni Araç Ekle
    </a>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <table class="table table-hover table-striped align-middle">
            <thead class="table-dark">
                <tr>
                    <th>Plaka</th>
                    <th>Araç Tipi</th>
                    <th>Marka</th>
                    <th>Model</th>
                    <th>Sahip Adı</th>
                    <th>Sahip TC</th>
                    <th>Durum</th>
                    <th>İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model) {
                <tr>
                    <td><span class="badge bg-secondary fs-6">@item.PlateNumber</span></td>
                    <td>@item.VehicleType</td>
                    <td>@item.Brand.Name</td>
                    <td>@item.Model.Name</td>
                    <td>@item.OwnerName</td>
                    <td>@item.OwnerTC</td>
                    <td>
                        @if(item.IsActive) {
                            <span class="badge bg-success">Aktif</span>
                        } else {
                            <span class="badge bg-danger">Pasif</span>
                        }
                    </td>
                    <td>
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info text-white">
                            <i class="bi bi-eye"></i> Detay
                        </a>
                    </td>
                </tr>
                }
            </tbody>
        </table>
    </div>
</div>
