@model trafficFineManager.Models.DashboardViewModel
@{
    ViewData["Title"] = "Yönetim Paneli (Dashboard)";
}

<style>
    .dash-card {
        border-radius: 12px !important;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
        cursor: pointer;
        text-decoration: none;
        display: block;
        color: inherit;
        border: none !important;
    }
    .dash-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 10px 20px rgba(0,0,0,0.15) !important;
        color: inherit;
    }
    .dash-card.bg-primary:hover { background-color: #0b5ed7 !important; }
    .dash-card.bg-success:hover { background-color: #157347 !important; }
    .dash-card.bg-secondary:hover { background-color: #5c636a !important; }
    .dash-card.bg-info:hover { background-color: #31d2f2 !important; }
    .dash-card.bg-warning:hover { background-color: #ffca2c !important; }

    .stat-box {
        border-radius: 8px !important;
        background-color: #ffffff;
        border: 1px solid #dee2e6;
        padding: 15px;
    }
</style>

<div class="row mb-4 align-items-center">
    <div class="col-md-8">
        <h3 class="fw-bold text-dark mb-1">Hoş Geldiniz, @User.Identity?.Name</h3>
        <p class="text-muted">İşte sistemdeki güncel özet bilgileriniz.</p>
    </div>
</div>

<!-- Ana 3'lü Kartlar -->
<div class="row g-4 mb-4">
    <!-- Bekleyenler -->
    <div class="col-md-4">
        <a href="/TrafficFine/List?filter=@(Model.UserRole == "Yonetici" ? "yonetici_bekleyen" : (Model.UserRole == "Finansman" ? "finans_bekleyen" : "all"))" class="card shadow-sm dash-card bg-primary text-white h-100">
            <div class="card-body p-4 d-flex flex-column justify-content-center align-items-center text-center">
                <i class="bi bi-clock-history fs-1 mb-2"></i>
                <h5 class="fw-bold mb-1">Bekleyen İşlemler</h5>
                <h2 class="display-5 fw-bold mb-2">@Model.PendingCount <span class="fs-6">Adet</span></h2>
                <div class="badge bg-white text-primary fs-6 py-2 px-3 rounded-pill mt-auto">
                    Toplam: @Model.PendingTotalAmount.ToString("N2") TL
                </div>
            </div>
        </a>
    </div>
    
    <!-- Onaylananlar -->
    <div class="col-md-4">
        <a href="/TrafficFine/List?filter=onaylanan" class="card shadow-sm dash-card bg-success text-white h-100">
            <div class="card-body p-4 d-flex flex-column justify-content-center align-items-center text-center">
                <i class="bi bi-check-circle fs-1 mb-2"></i>
                <h5 class="fw-bold mb-1">Onaylanan İşlemler</h5>
                <h2 class="display-5 fw-bold mb-2">@Model.ApprovedCount <span class="fs-6">Adet</span></h2>
                <div class="badge bg-white text-success fs-6 py-2 px-3 rounded-pill mt-auto">
                    Kasa: @Model.ApprovedTotalAmount.ToString("N2") TL
                </div>
            </div>
        </a>
    </div>
    
    <!-- Toplam Kayıtlar -->
    <div class="col-md-4">
        <a href="/TrafficFine/List?filter=all" class="card shadow-sm dash-card bg-secondary text-white h-100">
            <div class="card-body p-4 d-flex flex-column justify-content-center align-items-center text-center">
                <i class="bi bi-files fs-1 mb-2"></i>
                <h5 class="fw-bold mb-1">Toplam İşlem Hacmi</h5>
                <h2 class="display-5 fw-bold mb-2">@Model.TotalCount <span class="fs-6">Kayıt</span></h2>
                <div class="badge bg-white text-secondary fs-6 py-2 px-3 rounded-pill mt-auto">
                    İptaller: @Model.RejectedCount Adet
                </div>
            </div>
        </a>
    </div>
</div>

<div class="row">
    <!-- Zaman Bazlı Ortalama ve Toplamlar -->
    <div class="col-lg-8 mb-4">
        <div class="card border-0 shadow-sm" style="border-radius: 8px !important;">
            <div class="card-header bg-white border-bottom py-3">
                <h5 class="mb-0 fw-bold text-dark"><i class="bi bi-bar-chart-fill text-primary me-2"></i>Dönemsel Ceza İstatistikleri</h5>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light text-muted">
                            <tr>
                                <th>Periyot</th>
                                <th class="text-center">Kayıt Sayısı</th>
                                <th class="text-end">Toplam Tutar</th>
                                <th class="text-end">Ortalama Tutar</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td class="fw-bold"><i class="bi bi-calendar-day text-info me-2"></i>Bugün</td>
                                <td class="text-center">@Model.DailyCount</td>
                                <td class="text-end fw-bold text-dark">@Model.DailyTotal.ToString("N2") TL</td>
                                <td class="text-end text-muted">@Model.DailyAverage.ToString("N2") TL</td>
                            </tr>
                            <tr>
                                <td class="fw-bold"><i class="bi bi-calendar-week text-primary me-2"></i>Bu Hafta</td>
                                <td class="text-center">@Model.WeeklyCount</td>
                                <td class="text-end fw-bold text-dark">@Model.WeeklyTotal.ToString("N2") TL</td>
                                <td class="text-end text-muted">@Model.WeeklyAverage.ToString("N2") TL</td>
                            </tr>
                            <tr>
                                <td class="fw-bold"><i class="bi bi-calendar-month text-warning me-2"></i>Bu Ay</td>
                                <td class="text-center">@Model.MonthlyCount</td>
                                <td class="text-end fw-bold text-dark">@Model.MonthlyTotal.ToString("N2") TL</td>
                                <td class="text-end text-muted">@Model.MonthlyAverage.ToString("N2") TL</td>
                            </tr>
                            <tr>
                                <td class="fw-bold"><i class="bi bi-calendar3 text-danger me-2"></i>Bu Yıl</td>
                                <td class="text-center">@Model.YearlyCount</td>
                                <td class="text-end fw-bold text-dark">@Model.YearlyTotal.ToString("N2") TL</td>
                                <td class="text-end text-muted">@Model.YearlyAverage.ToString("N2") TL</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- En Çok Ceza Yiyen -->
    <div class="col-lg-4 mb-4">
        <div class="card border-0 shadow-sm h-100" style="border-radius: 8px !important;">
            <div class="card-header bg-white border-bottom py-3">
                <h5 class="mb-0 fw-bold text-danger"><i class="bi bi-exclamation-triangle-fill me-2"></i>En Fazla Ceza Alan</h5>
            </div>
            <div class="card-body d-flex flex-column justify-content-center text-center">
                @if (Model.MostFinedPersonCount > 0)
                {
                    <div class="mb-4">
                        <i class="bi bi-person-circle text-muted" style="font-size: 4rem;"></i>
                    </div>
                    <h4 class="fw-bold text-dark mb-1">@Model.MostFinedPersonName</h4>
                    @if (User.IsInRole("Yonetici")) {
                        <p class="text-muted small mb-3">TC: @Model.MostFinedPersonTC</p>
                    }
                    
                    <div class="row g-2 mt-auto">
                        <div class="col-6">
                            <div class="stat-box">
                                <span class="d-block text-muted small">Ceza Sayısı</span>
                                <span class="fs-4 fw-bold text-danger">@Model.MostFinedPersonCount</span>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="stat-box">
                                <span class="d-block text-muted small">Toplam Tutar</span>
                                <span class="fs-5 fw-bold text-dark">@Model.MostFinedPersonTotalAmount.ToString("N0") TL</span>
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    <div class="text-muted py-5">
                        <i class="bi bi-inbox fs-1 d-block mb-3"></i>
                        Sistemde henüz ceza kaydı bulunmuyor.
                    </div>
                }
            </div>
        </div>
    </div>
</div>
