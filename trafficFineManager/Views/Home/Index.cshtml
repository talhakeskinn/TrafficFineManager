@{
    ViewData["Title"] = "Ana Sayfa - Ceza Sorgulama";
}

<div class="text-center mt-5 mb-5">
    <h1 class="display-4 text-primary fw-bold">Trafik Cezası Sorgulama Sistemi</h1>
    <p class="lead text-muted">Aracınıza ait trafik cezalarını öğrenmek için plakanızı giriniz.</p>
</div>

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card shadow-sm border-0">
            <div class="card-body p-4">
                <form id="plateQueryForm" action="/Home/QueryPlate" method="get">
                    <div class="input-group input-group-lg mb-3">
                        <input type="text" name="plate" class="form-control text-uppercase font-monospace text-center" 
                               placeholder="ÖRN: 34ABC123" required maxlength="10">
                        <button class="btn btn-primary px-4" type="submit">Sorgula</button>
                    </div>
                    <div class="text-center">
                        <small class="text-muted">Lütfen plakanızı boşluk bırakmadan bitişik yazınız.</small>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- This div will hold the query results via AJAX or regular postback (for now, postback) -->
@if (ViewBag.QueriedPlate != null)
{
    <div class="row justify-content-center mt-5">
        <div class="col-md-10">
            <h4 class="mb-3"><strong>@ViewBag.QueriedPlate</strong> Plakalı Araç Ceza Geçmişi</h4>
            
            @if (ViewBag.Fines != null && ((List<trafficFineManager.Entities.TrafficFine>)ViewBag.Fines).Count > 0)
            {
                <table class="table table-striped table-hover shadow-sm align-middle bg-white">
                    <thead class="table-dark">
                        <tr>
                            <th>Tarih</th>
                            <th>Ceza Maddesi</th>
                            <th>Sürücü</th>
                            <th>Tutar</th>
                            <th>Durum</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var fine in (List<trafficFineManager.Entities.TrafficFine>)ViewBag.Fines)
                        {
                            <tr>
                                <td>@fine.NotificationDate.ToString("dd.MM.yyyy HH:mm")</td>
                                <td>
                                    <span class="badge bg-secondary">@(fine.FineType?.ArticleNumber ?? "-")</span><br/>
                                    <small>@fine.ViolationReason</small>
                                </td>
                                <td>@fine.ViolatorName <br/><small class="text-muted">TC: @fine.ViolatorTC</small></td>
                                <td class="text-danger fw-bold">@fine.Amount.ToString("C")</td>
                                <td>
                                    @if (fine.Status == trafficFineManager.Entities.Enums.FineStatus.Tamamlandi)
                                    {
                                        <span class="badge bg-success">Onaylandı / Kesinleşti</span>
                                    }
                                    else if (fine.Status == trafficFineManager.Entities.Enums.FineStatus.Reddedildi)
                                    {
                                        <span class="badge bg-danger">İptal Edildi</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark">İşlemde</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <div class="alert alert-success text-center">
                    <h5>Harika!</h5>
                    <p class="mb-0">Bu plakaya ait herhangi bir ceza kaydı bulunamamıştır.</p>
                </div>
            }
        </div>
    </div>
}
