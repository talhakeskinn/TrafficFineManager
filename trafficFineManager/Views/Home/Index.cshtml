@{
    ViewData["Title"] = "Ceza Sorgulama";
}

<div class="text-center mt-5 mb-5">
    <div class="mb-3">
        <i class="bi bi-search text-dark" style="font-size: 3rem;"></i>
    </div>
    <h2 class="text-dark fw-bold">Kurumsal Ceza Sorgulama Sistemi</h2>
    <p class="lead text-muted small">Sisteme kayıtlı araç plakaları üzerinden güncel ceza durumunu sorgulayabilirsiniz.</p>
</div>

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card shadow-sm border-0 rounded-3" style="border-top: 5px solid #212529 !important;">
            <div class="card-body p-5 bg-white">
                <form id="plateQueryForm" action="/Home/QueryPlate" method="get">
                    <label class="fw-bold mb-2 small text-muted">Araç Plakası</label>
                    <div class="input-group input-group-lg mb-3">
                        <span class="input-group-text bg-light border-end-0"><i class="bi bi-123 text-muted"></i></span>
                        <input type="text" name="plate" class="form-control border-start-0 ps-0 text-uppercase font-monospace fw-bold" 
                               placeholder="ÖRN: 34ABC123" required maxlength="10">
                        <button class="btn btn-dark px-4 fw-bold" type="submit"><i class="bi bi-search me-2"></i> Sorgula</button>
                    </div>
                    <div class="text-start mb-4">
                        <small class="text-muted fst-italic"><i class="bi bi-info-circle me-1"></i> Lütfen plakanızı boşluk bırakmadan bitişik yazınız.</small>
                    </div>
                </form>
                
                <div class="text-center mt-4 border-top pt-4">
                    <p class="text-muted small mb-2">Sistem yöneticisi veya yetkili personel misiniz?</p>
                    <a asp-controller="Auth" asp-action="Login" class="btn btn-outline-dark fw-bold px-4 rounded-pill"><i class="bi bi-shield-lock me-2"></i> Yetkili Personel Girişi</a>
                </div>
            </div>
        </div>
    </div>
</div>

@if (ViewBag.QueriedPlate != null)
{
    <div class="row justify-content-center mt-5">
        <div class="col-md-12">
            @if (ViewBag.VehicleInfo != null)
            {
                <div class="card shadow-sm border-0 mb-4 bg-white border-start border-4 border-dark">
                    <div class="card-body d-flex align-items-center justify-content-between p-4">
                        <div>
                            <h6 class="text-muted text-uppercase fw-bold mb-1 small">Sorgulanan Araç Bilgileri</h6>
                            <h4 class="mb-0 fw-bold text-dark"><span class="text-primary font-monospace me-2">@ViewBag.QueriedPlate</span> @ViewBag.VehicleInfo</h4>
                        </div>
                        <div class="text-muted bg-light p-3 rounded-circle">
                            <i class="bi bi-car-front-fill fs-2"></i>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <div class="d-flex justify-content-between align-items-center mb-3 border-bottom pb-2">
                    <h4 class="fw-bold text-dark mb-0">
                        <span class="text-primary font-monospace">@ViewBag.QueriedPlate</span> Plakalı Araç Ceza Geçmişi
                    </h4>
                </div>
            }
            
            @if (ViewBag.Fines != null && ((List<trafficFineManager.Entities.TrafficFine>)ViewBag.Fines).Count > 0)
            {
                <div class="card shadow-sm border-0 rounded-3">
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-bordered table-hover align-middle mb-0 bg-white">
                                <thead class="table-dark text-center">
                                    <tr>
                                        <th>Ceza Tarihi</th>
                                        <th>Saat</th>
                                        <th>Araç Tipi</th>
                                        <th>Ceza Yeri</th>
                                        <th>Ceza Maddesi</th>
                                        <th>İhlal Nedeni</th>
                                        <th>Sürücü</th>
                                        <th>Ceza Tutarı</th>
                                        <th>Durum</th>
                                        <th>İşlem Geçmişi</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var fine in (List<trafficFineManager.Entities.TrafficFine>)ViewBag.Fines)
                                    {
                                        <tr>
                                            <td class="text-center fw-bold text-muted">@fine.ViolationDate.ToString("dd.MM.yyyy")</td>
                                            <td class="text-center">@fine.ViolationDate.ToString("HH:mm")</td>
                                            <td class="text-center"><span class="badge bg-light text-dark border">@fine.Vehicle.VehicleType.ToString()</span></td>
                                            <td>@fine.City?.Name / @fine.District?.Name</td>
                                            <td class="text-center"><span class="badge bg-secondary font-monospace fs-6">@(fine.FineType?.ArticleNumber ?? "-")</span></td>
                                            <td><small class="text-muted">@fine.ViolationReason</small></td>
                                            <td class="fw-bold">@fine.ViolatorName</td>
                                            <td class="text-danger fw-bold fs-5 text-end pe-3">@fine.Amount.ToString("N2") ₺</td>
                                            <td class="text-center">
                                                @if (fine.Status == trafficFineManager.Entities.Enums.FineStatus.Tamamlandi)
                                                {
                                                    <span class="badge bg-success mb-1 w-100">Onaylandı / Kesinleşti</span>
                                                }
                                                else if (fine.Status == trafficFineManager.Entities.Enums.FineStatus.Reddedildi)
                                                {
                                                    <span class="badge bg-danger mb-1 w-100">İptal Edildi (Reddedildi)</span>
                                                    var rejectLog = fine.Histories?.OrderByDescending(h => h.Id).FirstOrDefault(h => h.ActionType == trafficFineManager.Entities.Enums.ActionType.Reddedildi);
                                                    if (rejectLog != null)
                                                    {
                                                        <div class="text-danger small mt-1 text-start"><strong>Neden:</strong> @rejectLog.Description</div>
                                                    }
                                                }
                                                else if (fine.Status == trafficFineManager.Entities.Enums.FineStatus.FinansOnayinda)
                                                {
                                                    <span class="badge bg-warning text-dark mb-1 w-100">Finans Onayı Bekleniyor</span>
                                                }
                                                else if (fine.Status == trafficFineManager.Entities.Enums.FineStatus.YoneticiOnayinda)
                                                {
                                                    <span class="badge bg-warning text-dark mb-1 w-100">Yönetici Onayı Bekleniyor</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-info text-dark mb-1 w-100">İşlem Bekliyor</span>
                                                }
                                                <div class="mt-1 text-muted" style="font-size: 11px;">Kayıt: @fine.NotificationDate.ToString("dd.MM.yyyy HH:mm")</div>
                                            </td>
                                            <td class="text-center">
                                                <button type="button" class="btn btn-sm btn-outline-dark fw-bold" data-bs-toggle="modal" data-bs-target="#historyModal-@fine.Id">
                                                    <i class="bi bi-clock-history me-1"></i> Ayrıntılar
                                                </button>
                                            </td>
                                        </tr>

                                        <div class="modal fade" id="historyModal-@fine.Id" tabindex="-1" aria-labelledby="historyModalLabel-@fine.Id" aria-hidden="true">
                                          <div class="modal-dialog modal-lg">
                                            <div class="modal-content">
                                              <div class="modal-header bg-dark text-white">
                                                <h5 class="modal-title" id="historyModalLabel-@fine.Id"><i class="bi bi-list-ul me-2"></i> Ceza İşlem Geçmişi <span class="badge bg-light text-dark ms-2 font-monospace">Makbuz: @(fine.ReceiptNumber ?? "-")</span></h5>
                                                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Kapat"></button>
                                              </div>
                                              <div class="modal-body p-0">
                                                  @if(fine.Histories != null && fine.Histories.Any())
                                                  {
                                                      <ul class="list-group list-group-flush">
                                                          @foreach(var history in fine.Histories.OrderBy(h => h.ActionDate))
                                                          {
                                                              <li class="list-group-item p-3">
                                                                  <div class="d-flex w-100 justify-content-between align-items-center mb-2">
                                                                      <h6 class="mb-0">
                                                                          @if(history.ActionType == trafficFineManager.Entities.Enums.ActionType.Olusturuldu) { <span class="badge bg-primary">Oluşturuldu</span> }
                                                                          else if(history.ActionType == trafficFineManager.Entities.Enums.ActionType.Guncellendi) { <span class="badge bg-warning text-dark">Güncellendi</span> }
                                                                          else if(history.ActionType == trafficFineManager.Entities.Enums.ActionType.Onaylandi) { <span class="badge bg-success">Onaylandı</span> }
                                                                          else if(history.ActionType == trafficFineManager.Entities.Enums.ActionType.Reddedildi) { <span class="badge bg-danger">Reddedildi</span> }
                                                                      </h6>
                                                                      <small class="text-muted fw-bold"><i class="bi bi-calendar3 me-1"></i> @history.ActionDate.ToString("dd.MM.yyyy HH:mm:ss")</small>
                                                                  </div>
                                                                  <p class="mb-0 text-dark small border-start border-3 border-secondary ps-2 ms-1">@history.Description</p>
                                                              </li>
                                                          }
                                                      </ul>
                                                  }
                                                  else
                                                  {
                                                      <div class="p-5 text-center text-muted"><i class="bi bi-inbox fs-1 d-block mb-3"></i>İşlem geçmişi bulunamadı.</div>
                                                  }
                                              </div>
                                              <div class="modal-footer bg-light">
                                                <button type="button" class="btn btn-secondary px-4" data-bs-dismiss="modal">Kapat</button>
                                              </div>
                                            </div>
                                          </div>
                                        </div>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <div class="alert alert-success text-center p-5 shadow-sm border-0 rounded-3 mt-4">
                    <i class="bi bi-check-circle-fill text-success" style="font-size: 3rem;"></i>
                    <h4 class="fw-bold mt-3">Herhangi Bir Ceza Bulunamadı</h4>
                    <p class="text-muted mb-0"><strong>@ViewBag.QueriedPlate</strong> plakalı araca ait sistemimizde kayıtlı bir ceza işlemi yoktur.</p>
                </div>
            }
        </div>
    </div>
}
