@model List<trafficFineManager.Entities.TrafficFine>

@{
    ViewData["Title"] = ViewBag.FilterTitle ?? "Ceza Listesi";
    bool showSidebar = ViewBag.ShowSidebar == true; // We will use this to determine if we show the top filter bar
    string currentFilter = ViewBag.CurrentFilter as string ?? "all";
    
    // Determine button text based on filter
    string filterBtnText = "🌐 Tüm İşlemler";
    if(currentFilter == "yonetici_bekleyen") filterBtnText = "🕒 Yönetici Onayı Bekleyenler";
    else if(currentFilter == "finans_bekleyen") filterBtnText = "🕒 Finans Onayı Bekleyenler";
    else if(currentFilter == "onaylanan") filterBtnText = "✅ Onaylananlar";
    else if(currentFilter == "reddedilen") filterBtnText = "❌ Reddedilenler";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>@(ViewBag.FilterTitle ?? "Kesilen Trafik Cezaları")</h2>
    </div>
    @if (showSidebar)
    {
        <!-- Horizontal Filter Bar above the table -->
        <div class="card shadow-sm border-0 mb-3 bg-light">
            <div class="card-body py-2 d-flex justify-content-between align-items-center">
                <!-- Dropdown on the Left -->
                <div class="dropdown">
                    <button class="btn btn-white border bg-white dropdown-toggle fw-bold text-dark px-4 shadow-sm" type="button" id="filterDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                        @filterBtnText
                    </button>
                    <ul class="dropdown-menu shadow-sm" aria-labelledby="filterDropdown">
                        <li><a class="dropdown-item @(currentFilter == "all" ? "active bg-primary" : "")" asp-action="List" asp-route-filter="all">🌐 Tüm İşlemler</a></li>
                        <li><hr class="dropdown-divider"></li>
                        <li><a class="dropdown-item @(currentFilter == "yonetici_bekleyen" ? "active bg-primary" : "")" asp-action="List" asp-route-filter="yonetici_bekleyen">🕒 Yönetici Onayı Bekleyenler</a></li>
                        <li><a class="dropdown-item @(currentFilter == "finans_bekleyen" ? "active bg-primary" : "")" asp-action="List" asp-route-filter="finans_bekleyen">🕒 Finans Onayı Bekleyenler</a></li>
                        <li><hr class="dropdown-divider"></li>
                        <li><a class="dropdown-item text-success @(currentFilter == "onaylanan" ? "active text-white bg-success" : "")" asp-action="List" asp-route-filter="onaylanan">✅ Onaylananlar</a></li>
                        <li><a class="dropdown-item text-danger @(currentFilter == "reddedilen" ? "active text-white bg-danger" : "")" asp-action="List" asp-route-filter="reddedilen">❌ Reddedilenler</a></li>
                    </ul>
                </div>
                
                <!-- Action Toolbar on the Right -->
                <div class="d-flex gap-2 align-items-center">
                    <span class="text-muted small me-2 fw-bold d-none d-md-inline">Seçili İşlem:</span>
                    <button type="button" class="btn btn-sm btn-outline-info action-btn fw-bold" id="btnDetail" disabled>📄 Detay</button>
                    <button type="button" class="btn btn-sm btn-outline-primary action-btn fw-bold" id="btnHistory" disabled>🕒 Geçmiş</button>
                    <button type="button" class="btn btn-sm btn-outline-warning action-btn fw-bold" id="btnEdit" disabled>✏️ Düzenle</button>
                    @if (User.IsInRole("Yonetici") || User.IsInRole("Finansman"))
                    {
                        <button type="button" class="btn btn-sm btn-outline-success action-btn fw-bold" id="btnApprove" disabled>✅ Onayla</button>
                        <button type="button" class="btn btn-sm btn-outline-danger action-btn fw-bold" id="btnReject" disabled>❌ Reddet</button>
                    }
                </div>
            </div>
        </div>
    }

    <style>
        .compact-table {
            table-layout: fixed;
            width: 100%;
            font-size: 0.85rem;
        }
        .compact-table th, .compact-table td {
            overflow: hidden;
            word-wrap: break-word;
            vertical-align: middle;
        }
        .row-selectable {
            cursor: pointer;
        }
        .row-selectable:hover td {
            background-color: #eaeff4 !important; /* Daha belirgin gri/mavi hover */
        }
        .row-selected td {
            background-color: #cce5ff !important; /* Tamamen farklı, belirgin mavi seçim */
        }
        
        .sorted-col {
            background-color: #f8f9fa !important;
        }
        
        /* İnce kenarlıklı yeni buton stili */
        .action-btn {
            border: 1px solid #adb5bd !important;
            background-color: #ffffff;
            color: #495057;
            transition: all 0.2s;
        }
        .action-btn:hover:not(:disabled) {
            background-color: #f8f9fa;
            border-color: #6c757d !important;
            color: #212529;
        }
        
        .action-btn:disabled {
            opacity: 0.5;
            cursor: not-allowed;
            background-color: #f8f9fa !important;
            border-color: #dee2e6 !important;
            color: #6c757d !important;
        }
        
        /* Özel buton renkleri */
        #btnDetail:not(:disabled) { color: #0dcaf0; border-color: #0dcaf0 !important; }
        #btnHistory:not(:disabled) { color: #0d6efd; border-color: #0d6efd !important; }
        #btnEdit:not(:disabled) { color: #ffc107; border-color: #ffc107 !important; }
        #btnApprove:not(:disabled) { color: #198754; border-color: #198754 !important; }
        #btnReject:not(:disabled) { color: #dc3545; border-color: #dc3545 !important; }
    </style>

    <div class="row">
        <div class="col-md-12">
            <div class="table-responsive">
                <table class="table table-bordered shadow-sm compact-table" style="width: 100%; min-width: 1000px;">
                    <thead class="table-dark text-center">
                        <tr>
                            <th style="width: 5%;">No</th>
                            <th style="width: 10%;">Plaka</th>
                            <th style="width: 13%;">Araç Sahibi</th>
                            <th style="width: 12%;">Sürücü</th>
                            <th style="width: 8%;">İhlal Mad.</th>
                            <th style="width: 12%;">Bölge</th>
                            <th style="width: 10%;">Ceza Tutarı</th>
                            <th style="width: 14%;">Tarih</th>
                            <th style="width: 8%;">Durum</th>
                            <th style="width: 8%;">İşlemi Yapan</th>
                        </tr>
                        <tr class="table-secondary text-dark">
                            <td class="p-1"></td>
                            <td class="p-1"><input type="text" class="form-control form-control-sm column-filter" data-col="1" placeholder="Plaka" /></td>
                            <td class="p-1"><input type="text" class="form-control form-control-sm column-filter" data-col="2" placeholder="Sahibi" /></td>
                            <td class="p-1"><input type="text" class="form-control form-control-sm column-filter" data-col="3" placeholder="Sürücü" /></td>
                            <td class="p-1">
                                <select class="form-select form-select-sm column-select" data-col="4">
                                    <option value="">Tümü</option>
                                    @foreach(var type in Model.Select(m => m.FineType?.ArticleNumber).Where(a => !string.IsNullOrEmpty(a)).Distinct()) {
                                        <option value="@type">@type</option>
                                    }
                                </select>
                            </td>
                            <td class="p-1"><input type="text" class="form-control form-control-sm column-filter" data-col="5" placeholder="İl/İlçe" /></td>
                            <td class="p-1">
                                <input type="text" class="form-control form-control-sm amount-filter" data-col="6" placeholder="Örn: 3.135" />
                            </td>
                            <td class="p-1">
                                <div class="d-flex gap-1 justify-content-center">
                                    <input type="date" class="form-control form-control-sm date-min px-1" title="Başlangıç Tarihi" />
                                    <input type="date" class="form-control form-control-sm date-max px-1" title="Bitiş Tarihi" />
                                </div>
                            </td>
                            <td class="p-1">
                                <select class="form-select form-select-sm column-select" data-col="8">
                                    <option value="">Tümü</option>
                                    <option value="Bekliyor">Onay Bekleyenler</option>
                                    <option value="Onaylandı">Onaylandı</option>
                                    <option value="İptal Edildi">İptal Edildi</option>
                                </select>
                            </td>
                            <td class="p-1"><input type="text" class="form-control form-control-sm column-filter" data-col="9" placeholder="Personel" /></td>
                        </tr>
                    </thead>
                    <tbody id="fineTableBody">
                        @if(!Model.Any()) {
                            <tr><td colspan="10" class="text-center text-muted py-3">Bu filtreye uygun ceza kaydı bulunmuyor.</td></tr>
                        }
                        @foreach (var fine in Model)
                        {
                            <tr class="row-selectable" 
                                data-id="@fine.Id" 
                                data-plate="@fine.Vehicle.PlateNumber" 
                                data-owner="@fine.Vehicle.OwnerName"
                                data-driver="@fine.ViolatorName"
                                data-tc="@fine.ViolatorTC"
                                data-article="@(fine.FineType?.ArticleNumber ?? "-")"
                                data-reason="@fine.ViolationReason"
                                data-amount="@fine.Amount.ToString("N2") TL"
                                data-date="@fine.NotificationDate.ToString("dd.MM.yyyy HH:mm")"
                                data-status="@fine.Status.ToString()"
                                data-creator="@fine.CreatorUser.FirstName @fine.CreatorUser.LastName"
                                data-city="@(fine.City?.Name ?? "-") / @(fine.District?.Name ?? "-")"
                                data-receipt="@fine.ReceiptNumber"
                                data-vehicle-brand="@(fine.Vehicle.Brand?.Name ?? "-") @(fine.Vehicle.Model?.Name ?? "-")"
                                data-vehicle-type="@fine.Vehicle.VehicleType.ToString()"
                                data-vehicle-active="@(fine.Vehicle.IsActive ? "✅ Aktif (Kullanımda)" : "❌ Pasif (Kullanım Dışı)")"
                                data-owner-tc="@fine.Vehicle.OwnerTC">
                                
                                <td class="text-center fw-bold">@fine.Id</td>
                                <td class="fw-bold text-center">@fine.Vehicle.PlateNumber</td>
                                <td>@fine.Vehicle.OwnerName</td>
                                <td>
                                    <span class="fw-bold">@fine.ViolatorName</span><br/>
                                    @if (User.IsInRole("Yonetici"))
                                    {
                                        <small class="text-muted">TC: @fine.ViolatorTC</small>
                                    }
                                </td>
                                <td class="text-center">
                                    <span class="badge bg-secondary">@(fine.FineType?.ArticleNumber ?? "-")</span>
                                </td>
                                <td class="text-center">
                                    <span class="fw-bold">@(fine.City?.Name ?? "-")</span><br/>
                                    <small class="text-muted">@(fine.District?.Name ?? "-")</small>
                                </td>
                                <td class="text-danger fw-bold text-end pe-3">@fine.Amount.ToString("N2") TL</td>
                                <td class="text-center" data-date="@fine.NotificationDate.ToString("yyyy-MM-dd")">@fine.NotificationDate.ToString("dd.MM.yyyy")</td>
                                <td class="text-center">
                                    @if (fine.Status == trafficFineManager.Entities.Enums.FineStatus.Yeni)
                                    {
                                        <span class="badge bg-primary w-100">Yönetici Bekliyor</span>
                                    }
                                    else if (fine.Status == trafficFineManager.Entities.Enums.FineStatus.Tamamlandi)
                                    {
                                        <span class="badge bg-success w-100">Onaylandı</span>
                                    }
                                    else if (fine.Status == trafficFineManager.Entities.Enums.FineStatus.Reddedildi)
                                    {
                                        <span class="badge bg-danger w-100">İptal Edildi</span>
                                    }
                                    else if (fine.Status == trafficFineManager.Entities.Enums.FineStatus.FinansOnayinda)
                                    {
                                        <span class="badge bg-warning text-dark w-100">Finans Bekliyor</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary w-100">@fine.Status</span>
                                    }
                                </td>
                                <td class="text-center">@fine.CreatorUser.FirstName @fine.CreatorUser.LastName</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Global Modals & Forms -->

<!-- Detail Modal -->
<div class="modal fade" id="detailModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-dark text-white">
                <h5 class="modal-title">📄 Ceza Kaydı Detayları</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <div class="row g-3">
                    <div class="col-12"><h6 class="border-bottom pb-1 mb-2 text-primary fw-bold">🚗 Araç & Sahip Bilgileri</h6></div>
                    <div class="col-md-3">
                        <label class="text-muted small mb-1">Araç Plakası</label>
                        <h6 class="fw-bold" id="detPlate">-</h6>
                    </div>
                    <div class="col-md-3">
                        <label class="text-muted small mb-1">Araç Durumu</label>
                        <h6 class="fw-bold" id="detVehicleActive">-</h6>
                    </div>
                    <div class="col-md-6">
                        <label class="text-muted small mb-1">Marka & Model (Tip)</label>
                        <h6 class="fw-bold" id="detVehicleBrand">-</h6>
                    </div>
                    <div class="col-md-6">
                        <label class="text-muted small mb-1">Araç Sahibi / Şirket</label>
                        <h6 class="fw-bold" id="detOwner">-</h6>
                    </div>
                    <div class="col-md-6">
                        <label class="text-muted small mb-1">Sahip TC / VKN</label>
                        <h6 class="fw-bold" id="detOwnerTc">-</h6>
                    </div>

                    <div class="col-12"><h6 class="border-bottom pb-1 mb-2 mt-3 text-primary fw-bold">👤 Sürücü Bilgileri</h6></div>
                    <div class="col-md-6">
                        <label class="text-muted small mb-1">Ceza Yiyen Sürücü</label>
                        <h6 class="fw-bold" id="detDriver">-</h6>
                    </div>
                    <div class="col-md-6">
                        <label class="text-muted small mb-1">Sürücü TC No</label>
                        <h6 class="fw-bold" id="detTc">-</h6>
                    </div>

                    <div class="col-12"><h6 class="border-bottom pb-1 mb-2 mt-3 text-primary fw-bold">📜 Ceza Bilgileri</h6></div>
                    <div class="col-md-6">
                        <label class="text-muted small mb-1">İhlal Maddesi</label>
                        <h6 class="fw-bold text-danger" id="detArticle">-</h6>
                    </div>
                    <div class="col-md-6">
                        <label class="text-muted small mb-1">Ceza Tutarı</label>
                        <h6 class="fw-bold text-danger fs-5" id="detAmount">-</h6>
                    </div>
                    <div class="col-12">
                        <label class="text-muted small mb-1">İhlal Nedeni</label>
                        <p class="fw-bold mb-0" id="detReason">-</p>
                    </div>
                    <div class="col-md-6">
                        <label class="text-muted small mb-1">Ceza Tarihi</label>
                        <h6 class="fw-bold" id="detDate">-</h6>
                    </div>
                    <div class="col-md-6">
                        <label class="text-muted small mb-1">Bölge</label>
                        <h6 class="fw-bold" id="detCity">-</h6>
                    </div>
                    <div class="col-md-6">
                        <label class="text-muted small mb-1">Makbuz No</label>
                        <h6 class="fw-bold" id="detReceipt">-</h6>
                    </div>
                    <div class="col-md-6">
                        <label class="text-muted small mb-1">İşlem Durumu</label>
                        <h6 class="fw-bold text-primary" id="detStatus">-</h6>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Kapat</button>
            </div>
        </div>
    </div>
</div>

<!-- Global Reject Modal -->
<div class="modal fade" id="globalRejectModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">❌ Cezayı Reddet</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="Reject" method="post">
                <div class="modal-body">
                    <input type="hidden" name="TrafficFineId" id="rejectFineId" />
                    <div class="form-group text-start">
                        <label class="fw-bold mb-2">Ret Nedeni:</label>
                        <textarea name="RejectReason" class="form-control" rows="3" required></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Vazgeç</button>
                    <button type="submit" class="btn btn-danger">Cezayı İptal Et</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Global Approve Form -->
<form asp-action="Approve" method="post" id="approveForm" class="d-none">
    <input type="hidden" name="id" id="approveFineId" />
</form>

@section Scripts {
    <script>
        $(document).ready(function() {
            var selectedId = null;

            // Row selection logic
            $(".row-selectable").on("click", function(e) {
                if ($(e.target).is("input, select, button, a")) return;
                
                $(".row-selectable").removeClass("row-selected");
                $(this).addClass("row-selected");

                selectedId = $(this).data("id");
                var status = $(this).data("status");
                
                $(".action-btn").prop("disabled", false);
                if (status === "Tamamlandi" || status === "Reddedildi") {
                    $("#btnEdit, #btnApprove, #btnReject").prop("disabled", true);
                }
            });

            // Toolbar Actions
            $("#btnDetail").on("click", function() {
                if(!selectedId) return;
                var row = $("tr[data-id='" + selectedId + "']");
                $("#detPlate").text(row.data("plate"));
                $("#detVehicleActive").text(row.data("vehicle-active"));
                $("#detVehicleBrand").text(row.data("vehicle-brand") + " (" + row.data("vehicle-type") + ")");
                $("#detOwner").text(row.data("owner"));
                $("#detOwnerTc").text(row.data("owner-tc") ? row.data("owner-tc") : "Gizli");
                $("#detDriver").text(row.data("driver"));
                $("#detTc").text(row.data("tc") ? row.data("tc") : "Gizli");
                $("#detArticle").text(row.data("article"));
                $("#detReason").text(row.data("reason"));
                $("#detAmount").text(row.data("amount"));
                $("#detDate").text(row.data("date"));
                $("#detCity").text(row.data("city"));
                $("#detReceipt").text(row.data("receipt") || "-");
                $("#detStatus").text(row.data("status"));
                new bootstrap.Modal(document.getElementById('detailModal')).show();
            });

            $("#btnHistory").on("click", function() {
                if(!selectedId) return;
                window.location.href = '/TrafficFine/History/' + selectedId;
            });

            $("#btnEdit").on("click", function() {
                if(!selectedId) return;
                window.location.href = '/TrafficFine/Edit/' + selectedId;
            });

            $("#btnApprove").on("click", function() {
                if(!selectedId) return;
                $("#approveFineId").val(selectedId);
                $("#approveForm").submit();
            });

            $("#btnReject").on("click", function() {
                if(!selectedId) return;
                $("#rejectFineId").val(selectedId);
                new bootstrap.Modal(document.getElementById('globalRejectModal')).show();
            });

            // Sorting Logic
            var sortDir = 1;
            var lastSortCol = -1;

            $("thead tr:first-child th").css("cursor", "pointer").on("click", function() {
                var colIdx = $(this).index();
                
                if (lastSortCol === colIdx) {
                    sortDir = sortDir * -1;
                } else {
                    sortDir = 1;
                }
                lastSortCol = colIdx;

                $("thead tr:first-child th i.sort-icon").remove();
                var iconClass = sortDir === 1 ? "bi-caret-down-fill" : "bi-caret-up-fill";
                $(this).append(' <i class="bi ' + iconClass + ' sort-icon text-info"></i>');

                var rows = $("#fineTableBody tr.row-selectable").get();

                rows.sort(function(a, b) {
                    var cellA = $(a).find("td").eq(colIdx).text().trim().toLowerCase();
                    var cellB = $(b).find("td").eq(colIdx).text().trim().toLowerCase();
                    
                    if (colIdx === 0) { 
                        return (parseInt(cellA) - parseInt(cellB)) * sortDir;
                    }
                    if (colIdx === 6) { 
                        var numA = parseFloat(cellA.replace(/\./g, '').replace(',', '.').replace(/[^\d.-]/g, '')) || 0;
                        var numB = parseFloat(cellB.replace(/\./g, '').replace(',', '.').replace(/[^\d.-]/g, '')) || 0;
                        return (numA - numB) * sortDir;
                    }
                    if (colIdx === 7) { 
                        var dateA = $(a).find("td").eq(colIdx).data("date") || "";
                        var dateB = $(b).find("td").eq(colIdx).data("date") || "";
                        return dateA.localeCompare(dateB) * sortDir;
                    }
                    return cellA.localeCompare(cellB, 'tr') * sortDir;
                });

                $("#fineTableBody td").removeClass("sorted-col");
                $.each(rows, function(index, row) {
                    $(row).find("td").eq(colIdx).addClass("sorted-col");
                    $("#fineTableBody").append(row); 
                });
                applyPagination();
            });

            // Filtering Logic
            function filterTable() {
                var filters = [];
                $(".column-filter, .column-select").each(function() {
                    var val = $(this).val().toLowerCase();
                    if (val) filters.push({ colIdx: $(this).data("col"), value: val });
                });

                var amountVal = $(".amount-filter").val().replace(/\./g, '').replace(/\s/g, ''); 
                var minDate = $(".date-min").val();
                var maxDate = $(".date-max").val();

                $("#fineTableBody tr.row-selectable").each(function() {
                    var row = $(this);
                    var showRow = true;

                    filters.forEach(function(f) {
                        if (showRow) {
                            var cellText = row.find("td").eq(f.colIdx).text().toLowerCase();
                            if (cellText.indexOf(f.value) === -1) showRow = false;
                        }
                    });

                    if (showRow && amountVal) {
                        var cellAmountText = row.find("td").eq(6).text().toLowerCase().replace(/\./g, '').replace(/\s/g, ''); 
                        if (cellAmountText.indexOf(amountVal) === -1) showRow = false;
                    }

                    if (showRow && (minDate || maxDate)) {
                        var cellDateStr = row.find("td").eq(7).data("date"); 
                        if (cellDateStr) {
                            var cellDate = new Date(cellDateStr);
                            if (minDate && cellDate < new Date(minDate)) showRow = false;
                            if (maxDate && cellDate > new Date(maxDate)) showRow = false;
                        }
                    }

                    if(showRow) row.addClass("filtered-in").show();
                    else row.removeClass("filtered-in").hide();
                });

                if (selectedId) {
                    var selectedRow = $("tr[data-id='" + selectedId + "']");
                    if (!selectedRow.hasClass("filtered-in")) {
                        $(".row-selectable").removeClass("row-selected");
                        selectedId = null;
                        $(".action-btn").prop("disabled", true);
                    }
                }
                
                currentPage = 1;
                applyPagination();
            }

            $(".amount-filter").on("input", function() {
                var raw = $(this).val().replace(/\D/g, ''); 
                if (!raw) {
                    $(this).val('');
                } else {
                    $(this).val(Number(raw).toLocaleString('tr-TR'));
                }
                filterTable(); 
            });

            $(".column-filter, .column-select, .date-min, .date-max").on("keyup change", filterTable);

            // Pagination Logic
            var currentPage = 1;
            var rowsPerPage = 10;

            function applyPagination() {
                var visibleRows = $("#fineTableBody tr.filtered-in");
                var totalRows = visibleRows.length;
                var totalPages = Math.ceil(totalRows / rowsPerPage) || 1;

                visibleRows.hide();
                var start = (currentPage - 1) * rowsPerPage;
                var end = start + rowsPerPage;
                visibleRows.slice(start, end).show();

                renderPaginationControls(totalPages);
            }

            function renderPaginationControls(totalPages) {
                $("#paginationContainer").remove();
                if(totalPages <= 1) return;
                
                var html = '<div id="paginationContainer" class="d-flex justify-content-center mt-3"><ul class="pagination pagination-sm">';
                
                html += '<li class="page-item ' + (currentPage === 1 ? 'disabled' : '') + '"><a class="page-link" href="#" data-page="prev">Önceki</a></li>';
                
                for(var i=1; i<=totalPages; i++) {
                    html += '<li class="page-item ' + (currentPage === i ? 'active' : '') + '"><a class="page-link" href="#" data-page="' + i + '">' + i + '</a></li>';
                }
                
                html += '<li class="page-item ' + (currentPage === totalPages ? 'disabled' : '') + '"><a class="page-link" href="#" data-page="next">Sonraki</a></li>';
                html += '</ul></div>';
                
                $(".table-responsive").after(html);
                
                $(".page-link").on("click", function(e) {
                    e.preventDefault();
                    var target = $(this).data("page");
                    if(target === "prev" && currentPage > 1) currentPage--;
                    else if(target === "next" && currentPage < totalPages) currentPage++;
                    else if(typeof target === "number") currentPage = target;
                    applyPagination();
                });
            }

            // Init
            $("#fineTableBody tr.row-selectable").addClass("filtered-in");
            applyPagination();
        });
    </script>
}
