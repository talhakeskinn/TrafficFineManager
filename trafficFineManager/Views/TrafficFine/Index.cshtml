@model List<trafficFineManager.Entities.TrafficFine>

@{
    ViewData["Title"] = "Ceza Listesi";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Kesilen Trafik Cezaları</h2>
        <a asp-action="Create" class="btn btn-success"> + Yeni Ceza Ekle</a>
    </div>
    <hr />

    <table class="table table-striped table-hover shadow-sm align-middle">
        <thead class="table-dark">
            <tr>
                <th>No</th>
                <th>Araç & Sahibi</th>
                <th>Ceza Yiyen Sürücü</th>
                <th>İhlal (Madde No)</th>
                <th>Tutar</th>
                <th>Tarih</th>
                <th>Durum</th>
                <th>İşlemi Yapan</th>
                <th>Aksiyonlar</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var fine in Model)
            {
                <tr>
                    <td>@fine.Id</td>
                    <td>
                        <span class="fw-bold">@fine.Vehicle.PlateNumber</span><br/>
                        <small class="text-muted">@fine.Vehicle.OwnerName</small>
                    </td>
                    <td>
                        <span class="fw-bold">@fine.ViolatorName</span><br/>
                        <small class="text-muted">TC: @fine.ViolatorTC</small>
                    </td>
                    <td>
                        <span class="badge bg-secondary">@(fine.FineType?.ArticleNumber ?? "-")</span><br/>
                        <small>@fine.ViolationReason</small>
                    </td>
                    <td class="text-danger fw-bold">@fine.Amount.ToString("C")</td>
                    <td>@fine.NotificationDate.ToString("dd.MM.yyyy HH:mm")</td>
                    <td>
                        @if (fine.Status == trafficFineManager.Entities.Enums.FineStatus.Yeni)
                        {
                            <span class="badge bg-primary">@fine.Status</span>
                        }
                        else if (fine.Status == trafficFineManager.Entities.Enums.FineStatus.Tamamlandi)
                        {
                            <span class="badge bg-success">@fine.Status</span>
                        }
                        else if (fine.Status == trafficFineManager.Entities.Enums.FineStatus.Reddedildi)
                        {
                            <span class="badge bg-danger">@fine.Status</span>
                        }
                        else
                        {
                            <span class="badge bg-warning text-dark">@fine.Status</span>
                        }
                    </td>
                    <td>@fine.CreatorUser.FirstName @fine.CreatorUser.LastName</td>
                    <td>
                        <div class="d-flex gap-2 align-items-center">
                            <a asp-action="History" asp-route-id="@fine.Id" class="btn btn-sm btn-info text-white">
                                🕒 Geçmiş
                            </a>

                            @if (fine.Status != trafficFineManager.Entities.Enums.FineStatus.Tamamlandi && fine.Status != trafficFineManager.Entities.Enums.FineStatus.Reddedildi)
                            {
                                <a asp-action="Edit" asp-route-id="@fine.Id" class="btn btn-sm btn-warning">
                                    ✏️ Düzenle
                                </a>

                                @if (User.IsInRole("Yonetici") || User.IsInRole("Finans"))
                                {
                                    <form asp-action="Approve" method="post" class="m-0">
                                        <input type="hidden" name="id" value="@fine.Id" />
                                        <button type="submit" class="btn btn-sm btn-success">✔ Onayla</button>
                                    </form>
                                    <button type="button" class="btn btn-sm btn-danger" data-bs-toggle="modal" data-bs-target="#rejectModal-@fine.Id">
                                        ✖ Reddet
                                    </button>
                                }
                            }
                        </div>

                        <!-- Modal Bloğu -->
                        @if (fine.Status != trafficFineManager.Entities.Enums.FineStatus.Tamamlandi && fine.Status != trafficFineManager.Entities.Enums.FineStatus.Reddedildi)
                        {
                            <div class="modal fade" id="rejectModal-@fine.Id" tabindex="-1" aria-hidden="true">
                                <div class="modal-dialog">
                                    <div class="modal-content">
                                        <div class="modal-header">
                                            <h5 class="modal-title">Cezayı Reddet</h5>
                                            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                        </div>
                                        <form asp-action="Reject" method="post">
                                            <div class="modal-body">
                                                <input type="hidden" name="TrafficFineId" value="@fine.Id" />
                                                <div class="form-group">
                                                    <label class="fw-bold mb-2">Ret Nedeni:</label>
                                                    <textarea name="RejectReason" class="form-control" rows="3" required></textarea>
                                                </div>
                                            </div>
                                            <div class="modal-footer">
                                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Vazgeç</button>
                                                <button type="submit" class="btn btn-danger">Cezayı İptal Et</button>
                                            </div>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>