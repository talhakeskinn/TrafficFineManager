@model trafficFineManager.ViewModels.EditTrafficFineViewModel

@{
    ViewData["Title"] = "Ceza Düzenle";
}

<div class="container mt-4">
    <h2>Trafik Cezası Düzenle</h2>
    <hr />
    <div asp-validation-summary="All" class="text-danger mb-3"></div>

    <form asp-action="Edit" method="post">
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="VehicleId" />

        <div class="row">
            <!-- ARAÇ BİLGİLERİ -->
            <div class="col-md-6 border-end">
                <h4 class="text-primary mb-3">🚗 Araç Bilgileri</h4>
                
                <div class="form-group mb-3">
                    <label class="control-label fw-bold">Plaka</label>
                    <input asp-for="PlateNumber" class="form-control text-uppercase" />
                    <span asp-validation-for="PlateNumber" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label class="control-label fw-bold">Marka</label>
                    <select asp-for="BrandId" class="form-select" asp-items="ViewBag.Brands">
                        <option value="">-- Marka Seçin --</option>
                    </select>
                    <span asp-validation-for="BrandId" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label class="control-label fw-bold">Model</label>
                    <select asp-for="ModelId" class="form-select" asp-items="ViewBag.Models">
                        <option value="">-- Model Seçin --</option>
                    </select>
                    <span asp-validation-for="ModelId" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label class="control-label fw-bold">Araç Tipi</label>
                    <select asp-for="VehicleType" class="form-select" asp-items="ViewBag.VehicleTypes">
                        <option value="">-- Araç Tipi Seçin --</option>
                    </select>
                    <span asp-validation-for="VehicleType" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label class="control-label fw-bold">Araç Sahibi (Ruhsat Sahibi)</label>
                    <input asp-for="OwnerName" class="form-control" />
                    <span asp-validation-for="OwnerName" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label class="control-label fw-bold">Araç Sahibi TC Kimlik No</label>
                    <input asp-for="OwnerTC" class="form-control" maxlength="11" />
                    <span asp-validation-for="OwnerTC" class="text-danger"></span>
                </div>
            </div>

            <!-- CEZA VE SÜRÜCÜ BİLGİLERİ -->
            <div class="col-md-6">
                <h4 class="text-danger mb-3">🚨 Ceza ve Sürücü Bilgileri</h4>

                <div class="form-group mb-3">
                    <label class="control-label fw-bold">Ceza Maddesi</label>
                    <select asp-for="FineTypeId" class="form-select" asp-items="ViewBag.FineTypes">
                        <option value="">-- Ceza Maddesi Seçin --</option>
                    </select>
                    <span asp-validation-for="FineTypeId" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label class="control-label fw-bold">Cezayı Yiyen Sürücü Ad/Soyad</label>
                    <input asp-for="ViolatorName" class="form-control" />
                    <span asp-validation-for="ViolatorName" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label class="control-label fw-bold">Sürücü TC Kimlik No</label>
                    <input asp-for="ViolatorTC" class="form-control" maxlength="11" />
                    <span asp-validation-for="ViolatorTC" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label class="control-label fw-bold">Ceza Yeme Tarihi (Olay Zamanı)</label>
                    <input asp-for="ViolationDate" class="form-control" type="datetime-local" value="@Model.ViolationDate.ToString("yyyy-MM-ddTHH:mm")" />
                    <span asp-validation-for="ViolationDate" class="text-danger"></span>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="control-label fw-bold">Ceza İli</label>
                        <select asp-for="CityId" class="form-select" asp-items="ViewBag.Cities">
                            <option value="">-- İl Seçiniz --</option>
                        </select>
                        <span asp-validation-for="CityId" class="text-danger"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="control-label fw-bold">Ceza İlçesi</label>
                        <select asp-for="DistrictId" class="form-select" asp-items="ViewBag.Districts">
                            <option value="">-- İlçe Seçiniz --</option>
                        </select>
                        <span asp-validation-for="DistrictId" class="text-danger"></span>
                    </div>
                </div>

                <div class="form-group mb-3">
                    <label class="control-label fw-bold">Makbuz Numarası</label>
                    <input asp-for="ReceiptNumber" class="form-control" />
                    <span asp-validation-for="ReceiptNumber" class="text-danger"></span>
                </div>

                <div class="form-group mt-4 text-end">
                    <a asp-action="Index" class="btn btn-secondary me-2">İptal</a>
                    <button type="submit" class="btn btn-warning px-5">Güncelle</button>
                </div>
            </div>
        </div>
    </form>
</div>