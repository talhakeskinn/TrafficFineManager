@model List<trafficFineManager.Entities.TrafficFineHistory>

@{
    ViewData["Title"] = "Personel İşlem Geçmişi";
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3 class="fw-bold text-dark"><i class="bi bi-clock-history text-secondary me-2"></i> Personel İşlem Geçmişi</h3>
    </div>
    
    <div class="card shadow-sm border-0 rounded-3">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-bordered shadow-sm compact-table mb-0" style="width: 100%; min-width: 1000px;">
                    <thead class="table-dark text-center">
                        <tr>
                            <th style="width: 15%;">Tarih</th>
                            <th style="width: 15%;">Personel</th>
                            <th style="width: 10%;">Rolü</th>
                            <th style="width: 12%;">İşlem Tipi</th>
                            <th style="width: 18%;">İlgili Plaka / Ceza ID</th>
                            <th style="width: 30%;">Detay (Eski -> Yeni Durum)</th>
                        </tr>
                        <tr class="table-secondary text-dark">
                            <td class="p-1">
                                <div class="d-flex gap-1 justify-content-center">
                                    <input type="date" class="form-control form-control-sm date-min px-1" title="Başlangıç" />
                                    <input type="date" class="form-control form-control-sm date-max px-1" title="Bitiş" />
                                </div>
                            </td>
                            <td class="p-1"><input type="text" class="form-control form-control-sm column-filter" data-col="1" placeholder="Personel Ara" /></td>
                            <td class="p-1">
                                <select class="form-select form-select-sm column-select" data-col="2">
                                    <option value="">Tümü</option>
                                    <option value="Yonetici">Yönetici</option>
                                    <option value="Finansman">Finansman</option>
                                    <option value="Standart">Standart Kullanıcı</option>
                                </select>
                            </td>
                            <td class="p-1">
                                <select class="form-select form-select-sm column-select" data-col="3">
                                    <option value="">Tümü</option>
                                    <option value="Oluşturuldu">Oluşturuldu</option>
                                    <option value="Güncellendi">Güncellendi</option>
                                    <option value="Onaylandı">Onaylandı</option>
                                    <option value="Reddedildi">Reddedildi</option>
                                </select>
                            </td>
                            <td class="p-1"><input type="text" class="form-control form-control-sm column-filter" data-col="4" placeholder="Plaka / Makbuz" /></td>
                            <td class="p-1"><input type="text" class="form-control form-control-sm column-filter" data-col="5" placeholder="Detaylarda Ara" /></td>
                        </tr>
                    </thead>
                    <tbody id="auditTableBody">
                        @if(!Model.Any()) {
                            <tr><td colspan="6" class="text-center text-muted py-3">Henüz işlem kaydı bulunmuyor.</td></tr>
                        }
                        @foreach (var log in Model)
                        {
                            <tr class="row-selectable">
                                <td class="text-center" data-date="@log.ActionDate.ToString("yyyy-MM-dd")">@log.ActionDate.ToString("dd.MM.yyyy HH:mm:ss")</td>
                                <td class="fw-bold">@log.User.FirstName @log.User.LastName</td>
                                <td class="text-center"><span class="badge bg-info text-dark">@(log.User.Role.Name == "Memur" ? "Standart Kullanıcı" : log.User.Role.Name)</span></td>
                                <td class="text-center">
                                    @if (log.ActionType == trafficFineManager.Entities.Enums.ActionType.Olusturuldu)
                                    {
                                        <span class="badge bg-primary w-100">Oluşturuldu</span>
                                    }
                                    else if (log.ActionType == trafficFineManager.Entities.Enums.ActionType.Guncellendi)
                                    {
                                        <span class="badge bg-warning text-dark w-100">Güncellendi</span>
                                    }
                                    else if (log.ActionType == trafficFineManager.Entities.Enums.ActionType.Onaylandi)
                                    {
                                        <span class="badge bg-success w-100">Onaylandı</span>
                                    }
                                    else if (log.ActionType == trafficFineManager.Entities.Enums.ActionType.Reddedildi)
                                    {
                                        <span class="badge bg-danger w-100">Reddedildi</span>
                                    }
                                </td>
                                <td class="text-center">
                                    <span class="fw-bold">@(log.TrafficFine?.Vehicle?.PlateNumber ?? "Bilinmiyor")</span><br />
                                    <small class="text-muted">Makbuz: @(log.TrafficFine?.ReceiptNumber ?? "ID: " + log.TrafficFineId)</small>
                                </td>
                                <td>
                                    <small>@log.Description</small><br/>
                                    @if(log.OldStatus.HasValue)
                                    {
                                        <small class="text-muted">(@log.OldStatus.Value -> @log.NewStatus)</small>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <style>
        .row-selectable {
            cursor: pointer;
        }
        .row-selectable:hover td {
            background-color: #eaeff4 !important;
        }
        .row-selected td {
            background-color: #cce5ff !important;
        }
        .sorted-col {
            background-color: #f8f9fa !important;
        }
    </style>
    <script>
        $(document).ready(function() {
            // Row selection logic
            $(".row-selectable").on("click", function(e) {
                if ($(e.target).is("input, select, button, a")) return;
                $(".row-selectable").removeClass("row-selected");
                $(this).addClass("row-selected");
            });

            // Sorting Logic
            var sortDir = 1;
            var lastSortCol = -1;

            $("thead tr:first-child th").css("cursor", "pointer").on("click", function() {
                var colIdx = $(this).index();
                
                if (lastSortCol === colIdx) {
                    sortDir = sortDir * -1;
                } else {
                    sortDir = 1;
                }
                lastSortCol = colIdx;

                $("thead tr:first-child th i.sort-icon").remove();
                var iconClass = sortDir === 1 ? "bi-caret-down-fill" : "bi-caret-up-fill";
                $(this).append(' <i class="bi ' + iconClass + ' sort-icon text-info"></i>');

                var rows = $("#auditTableBody tr.row-selectable").get();

                rows.sort(function(a, b) {
                    var cellA = $(a).find("td").eq(colIdx).text().trim().toLowerCase();
                    var cellB = $(b).find("td").eq(colIdx).text().trim().toLowerCase();
                    
                    if (colIdx === 0) { // Date
                        var dateA = $(a).find("td").eq(colIdx).data("date") || "";
                        var dateB = $(b).find("td").eq(colIdx).data("date") || "";
                        return dateA.localeCompare(dateB) * sortDir;
                    }
                    return cellA.localeCompare(cellB, 'tr') * sortDir;
                });

                $("#auditTableBody td").removeClass("sorted-col");
                $.each(rows, function(index, row) {
                    $(row).find("td").eq(colIdx).addClass("sorted-col");
                    $("#auditTableBody").append(row); 
                });
                applyPagination();
            });

            // Filtering Logic
            function filterTable() {
                var filters = [];
                $(".column-filter, .column-select").each(function() {
                    var val = $(this).val().toLowerCase();
                    if (val) filters.push({ colIdx: $(this).data("col"), value: val });
                });

                var minDate = $(".date-min").val();
                var maxDate = $(".date-max").val();

                $("#auditTableBody tr.row-selectable").each(function() {
                    var row = $(this);
                    var showRow = true;

                    filters.forEach(function(f) {
                        if (showRow) {
                            var cellText = row.find("td").eq(f.colIdx).text().toLowerCase();
                            if (cellText.indexOf(f.value) === -1) showRow = false;
                        }
                    });

                    if (showRow && (minDate || maxDate)) {
                        var cellDateStr = row.find("td").eq(0).data("date"); 
                        if (cellDateStr) {
                            var cellDate = new Date(cellDateStr);
                            if (minDate && cellDate < new Date(minDate)) showRow = false;
                            if (maxDate && cellDate > new Date(maxDate)) showRow = false;
                        }
                    }

                    if(showRow) row.addClass("filtered-in").show();
                    else row.removeClass("filtered-in").hide();
                });
                
                currentPage = 1;
                applyPagination();
            }

            $(".column-filter, .column-select, .date-min, .date-max").on("keyup change", filterTable);

            // Pagination Logic
            var currentPage = 1;
            var rowsPerPage = 10;

            function applyPagination() {
                var visibleRows = $("#auditTableBody tr.filtered-in");
                var totalRows = visibleRows.length;
                var totalPages = Math.ceil(totalRows / rowsPerPage) || 1;

                visibleRows.hide();
                var start = (currentPage - 1) * rowsPerPage;
                var end = start + rowsPerPage;
                visibleRows.slice(start, end).show();

                renderPaginationControls(totalPages);
            }

            function renderPaginationControls(totalPages) {
                $("#paginationContainer").remove();
                if(totalPages <= 1) return;
                
                var html = '<div id="paginationContainer" class="d-flex justify-content-center mt-3"><ul class="pagination pagination-sm">';
                html += '<li class="page-item ' + (currentPage === 1 ? 'disabled' : '') + '"><a class="page-link" href="#" data-page="prev">Önceki</a></li>';
                
                for(var i=1; i<=totalPages; i++) {
                    html += '<li class="page-item ' + (currentPage === i ? 'active' : '') + '"><a class="page-link" href="#" data-page="' + i + '">' + i + '</a></li>';
                }
                
                html += '<li class="page-item ' + (currentPage === totalPages ? 'disabled' : '') + '"><a class="page-link" href="#" data-page="next">Sonraki</a></li>';
                html += '</ul></div>';
                
                $(".table-responsive").after(html);
                
                $(".page-link").on("click", function(e) {
                    e.preventDefault();
                    var target = $(this).data("page");
                    if(target === "prev" && currentPage > 1) currentPage--;
                    else if(target === "next" && currentPage < totalPages) currentPage++;
                    else if(typeof target === "number") currentPage = target;
                    applyPagination();
                });
            }

            // Init
            $("#auditTableBody tr.row-selectable").addClass("filtered-in");
            applyPagination();
        });
    </script>
}
