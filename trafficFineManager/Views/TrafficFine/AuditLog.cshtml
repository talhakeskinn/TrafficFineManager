@model List<trafficFineManager.Entities.TrafficFineHistory>

@{
    ViewData["Title"] = "Personel Denetim Logu";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2><span class="text-primary">🛡️ Personel İşlem Geçmişi</span> (Audit Log)</h2>
        <span class="badge bg-secondary p-2 fs-6">Sadece Yöneticiler</span>
    </div>
    <hr />
    <p class="text-muted">Sistemde hangi personelin, hangi tarihte, hangi araca/cezaya ne işlem yaptığını buradan saniye saniye takip edebilirsiniz.</p>

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th>Tarih</th>
                            <th>Personel</th>
                            <th>Rolü</th>
                            <th>İşlem Tipi</th>
                            <th>İlgili Plaka / Ceza ID</th>
                            <th>Detay (Eski -> Yeni Durum)</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var log in Model)
                        {
                            <tr>
                                <td>@log.ActionDate.ToString("dd.MM.yyyy HH:mm:ss")</td>
                                <td class="fw-bold">@log.User.FirstName @log.User.LastName</td>
                                <td><span class="badge bg-info text-dark">@log.User.Role.Name</span></td>
                                <td>
                                    @if (log.ActionType == trafficFineManager.Entities.Enums.ActionType.Olusturuldu)
                                    {
                                        <span class="badge bg-primary">Oluşturuldu</span>
                                    }
                                    else if (log.ActionType == trafficFineManager.Entities.Enums.ActionType.Guncellendi)
                                    {
                                        <span class="badge bg-warning text-dark">Güncellendi</span>
                                    }
                                    else if (log.ActionType == trafficFineManager.Entities.Enums.ActionType.Onaylandi)
                                    {
                                        <span class="badge bg-success">Onaylandı</span>
                                    }
                                    else if (log.ActionType == trafficFineManager.Entities.Enums.ActionType.Reddedildi)
                                    {
                                        <span class="badge bg-danger">Reddedildi</span>
                                    }
                                </td>
                                <td>
                                    <span class="fw-bold">@(log.TrafficFine?.Vehicle?.PlateNumber ?? "Bilinmiyor")</span><br />
                                    <small class="text-muted">Makbuz: @(log.TrafficFine?.ReceiptNumber ?? "ID: " + log.TrafficFineId)</small>
                                </td>
                                <td>
                                    <small>@log.Description</small><br/>
                                    @if(log.OldStatus.HasValue)
                                    {
                                        <small class="text-muted">(@log.OldStatus.Value -> @log.NewStatus)</small>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
