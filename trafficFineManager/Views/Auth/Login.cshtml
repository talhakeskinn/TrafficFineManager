@model trafficFineManager.ViewModels.LoginViewModel

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Sistem Girişi - Trafik Cezası Yönetim Sistemi</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    
    <!-- Google Fonts: Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    
    <style>
        body {
            background-color: #e9ecef;
            font-family: 'Inter', sans-serif;
            height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .login-card {
            width: 100%;
            max-width: 450px;
            border: 0;
            border-top: 5px solid #212529; /* Dark top border for corporate feel */
            border-radius: 8px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.1);
            background: white;
            overflow: hidden;
        }
        .form-control:focus {
            box-shadow: none;
            border-color: #212529;
        }
    </style>
</head>
<body>
    <div class="login-card">
        <div class="p-4 p-md-5">
            <div class="text-center mb-4 border-bottom pb-3">
                <i class="bi bi-shield-lock-fill text-dark" style="font-size: 3rem;"></i>
                <h4 class="text-dark fw-bold mt-2 mb-1">Kurumsal Sistem Girişi</h4>
                <p class="text-muted small mb-0">Lütfen yetkili sicil numaranız ile oturum açınız.</p>
            </div>

            <div asp-validation-summary="ModelOnly" class="alert alert-danger p-2 small" role="alert"></div>

            <form asp-action="Login" method="post">
                <div class="form-group mb-3">
                    <label asp-for="Username" class="fw-bold mb-1 small text-muted">Sicil No veya TC Kimlik No</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0"><i class="bi bi-person text-muted"></i></span>
                        <input asp-for="Username" class="form-control border-start-0 ps-0" placeholder="Örn: S-001 veya 11111111111" />
                    </div>
                    <span asp-validation-for="Username" class="text-danger small"></span>
                </div>

                <div class="form-group mb-4">
                    <label asp-for="Password" class="fw-bold mb-1 small text-muted">Şifre</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0"><i class="bi bi-key text-muted"></i></span>
                        <input asp-for="Password" type="password" class="form-control border-start-0 ps-0" placeholder="••••••" />
                    </div>
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>

                <button type="submit" class="btn btn-dark w-100 fw-bold py-2"><i class="bi bi-box-arrow-in-right me-2"></i> Oturum Aç</button>
            </form>

            <div class="mt-4 text-center">
                <a href="/" class="text-decoration-none text-secondary small hover-dark"><i class="bi bi-arrow-left me-1"></i> Ceza Sorgulama Ekranına Dön</a>
            </div>

            <div class="mt-4 text-center bg-light p-3 rounded border">
                <small class="text-muted d-block mb-2"><i class="bi bi-info-circle me-1"></i> Test Kullanıcı Bilgileri (Şifre: 123456)</small>
                <div class="d-flex justify-content-between text-start small">
                    <div class="text-muted"><strong>S-001</strong> <span class="badge bg-secondary">Memur</span></div>
                    <div class="text-muted"><strong>S-002</strong> <span class="badge bg-dark">Yönetici</span></div>
                    <div class="text-muted"><strong>S-003</strong> <span class="badge bg-secondary">Finans</span></div>
                </div>
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
